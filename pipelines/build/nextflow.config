manifest {
    name            = 'nextstrain-build'
    description     = 'Augur phylogenetic build from sequences and metadata, exported for Auspice'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    input                   = null
    sequences               = null
    metadata                = null
    metadata_id_columns     = 'strain'
    outdir                  = 'output'
    name                    = 'build'
    title                   = null

    reference_preset        = null
    reference               = null
    auspice_config          = null
    lat_longs               = null

    exclude                 = null
    group_by                = null
    sequences_per_group     = null
    subsample_max_sequences = null
    min_length              = null
    min_date                = null
    max_date                = null

    timetree                = true
    clock_rate              = null
    clock_std_dev           = null
    clock_filter_iqd        = 4
    root                    = null
    coalescent              = null

    traits                  = null
    color_by                = null
    geo_resolutions         = null

    help                    = false
}

process {
    container     = 'quay.io/biocontainers/augur:34.3.0--pyhdfd78af_0'
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2
    cpus          = 1
    memory        = { 4.GB * task.attempt }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Runs against augur and friends installed on the host, e.g. in a conda env.
    local {
        process.container = null
        docker.enabled    = false
    }
}
