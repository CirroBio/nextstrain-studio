manifest {
    name            = 'nextstrain-nextclade'
    description     = 'Nextclade clade assignment, QC, alignment and tree placement'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    input        = null
    sequences    = null
    dataset_name = null
    dataset_tag  = null
    name         = 'nextclade'
    outdir       = 'output'
    help         = false
}

process {
    container     = 'quay.io/biocontainers/augur:34.3.0--pyhdfd78af_0'
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2
    cpus          = 1
    memory        = { 4.GB * task.attempt }

    withName: NEXTCLADE {
        container = 'quay.io/biocontainers/nextclade:3.25.1--h9ee0642_0'
    }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Runs against augur and friends installed on the host, e.g. in a conda env.
    local {
        process.container = null
        docker.enabled    = false
    }
}
