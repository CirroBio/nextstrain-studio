manifest {
    name            = 'nextstrain-build-from-tree'
    description     = 'Exports an existing Newick tree and its metadata for Auspice, with augur refine, traits and export'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    input               = null
    tree                = null
    metadata            = null
    alignment           = null
    metadata_id_columns = 'strain'
    outdir              = 'output'
    name                = 'tree'
    title               = null

    timetree            = false
    clock_rate          = null
    clock_std_dev       = null
    clock_filter_iqd    = null
    root                = null
    coalescent          = null

    traits              = null
    color_by            = null
    geo_resolutions     = null
    auspice_config      = null
    lat_longs           = null

    help                = false
}

process {
    // nextstrain/base plus procps; built from ../container/Dockerfile.
    container     = 'ghcr.io/cirrobio/nextstrain-studio-base:build-20261026T235949Z'
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries    = 2
    cpus          = 1
    memory        = { 4.GB * task.attempt }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    // Runs against augur and friends installed on the host, e.g. in a conda env.
    local {
        process.container = null
        docker.enabled    = false
    }
}
